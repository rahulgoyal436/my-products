@Test
@Tag("integration")
public void returnIdAfterMultipleUpdates() {
    
    Product product = new Product();
    
    Long firstId = 100L;
    
    Long secondId = 200L;
    
    Long thirdId = 300L;
    
    product.setId(firstId);
    assertEquals(firstId, product.getId(), "Expected id to match the first value set.");
    product.setId(secondId);
    assertEquals(secondId, product.getId(), "Expected id to match the second value set.");
    product.setId(thirdId);
    assertEquals(thirdId, product.getId(), "Expected id to match the third value set.");
}

