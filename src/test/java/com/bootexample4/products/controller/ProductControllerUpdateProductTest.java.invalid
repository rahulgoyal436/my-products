        when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(existingProduct)).thenReturn(existingProduct);
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, nullProductDetails);
        // Assert
        assertThat((int) response.getStatusCodeValue()).isEqualTo(200); 
        assertThat(response.getBody().getName()).isNull();
        assertThat(response.getBody().getDescription()).isNull();
        assertThat(response.getBody().getPrice()).isNull();
        verify(productRepository, times(1)).findById(productId);
        verify(productRepository, times(1)).save(existingProduct);
    }
    @Test
    @Tag("boundary")
    public void updateProductWithNegativeId() {
        // Arrange
        Long negativeId = -10L;
        Product productDetails = new Product();
        productDetails.setName("Product");
        productDetails.setDescription("Description");
        productDetails.setPrice(50.0);
        when(productRepository.findById(negativeId)).thenReturn(Optional.empty());
        // Act
        ResponseEntity<Product> response = productController.updateProduct(negativeId, productDetails);
        // Assert
        assertThat((int) response.getStatusCodeValue()).isEqualTo(404); 
        assertThat(response.getBody()).isNull();
        verify(productRepository, times(1)).findById(negativeId);
        verify(productRepository, times(0)).save(any());
    }
