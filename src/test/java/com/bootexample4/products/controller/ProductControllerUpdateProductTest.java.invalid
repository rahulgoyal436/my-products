        productController.setProductRepository(productRepositoryMock);
        Long productId = 1L; // Valid product ID
        Product existingProduct = new Product(); // Changed instantiation
        existingProduct.setId(productId);
        existingProduct.setName("Old Name");
        existingProduct.setDescription("Old Description");
        existingProduct.setPrice(10.00);
        Product updatedProductRequest = new Product(); // Changed instantiation
        updatedProductRequest.setId(productId);
        updatedProductRequest.setName("New Name");
        updatedProductRequest.setDescription("New Description");
        updatedProductRequest.setPrice(15.50);
        // Mock repository behavior
        when(productRepositoryMock.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepositoryMock.save(existingProduct)).thenReturn(updatedProductRequest);
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updatedProductRequest);
        // Assert
        assertThat((Integer) response.getStatusCodeValue()).isEqualTo(200); // Type casting added
        assertThat((Product) response.getBody()).isNotNull(); // Type casting added
        assertThat((Long) response.getBody().getId()).isEqualTo(productId); // Type casting added
        assertThat((String) response.getBody().getName()).isEqualTo(updatedProductRequest.getName()); // Type casting added
        assertThat((String) response.getBody().getDescription()).isEqualTo(updatedProductRequest.getDescription()); // Type casting added
        assertThat((Double) response.getBody().getPrice()).isEqualTo(updatedProductRequest.getPrice()); // Type casting added
    }
