    @Test
    @Tag("valid")
    public void updateExistingProductSuccessfully() {
        // Suggestion: Business logic might need modification so that the controller ProductController can accept the ProductRepository via constructor injection.
        // Arrange
        ProductRepository productRepositoryMock = Mockito.mock(ProductRepository.class);
        ProductController productController = new ProductController(); // Updated instantiation
