    @Test
    @Tag("valid")
    public void deleteProductWithExistingID() {
        // Arrange
        Long validID = 1L; 
        Product product = new Product();
        when(productRepository.findById(validID)).thenReturn(Optional.of(product));
        
        // Act
        ResponseEntity<Object> response = productController.deleteProduct(validID);
        // Assert
        verify(productRepository, times(1)).delete(product);
        assertThat((int) response.getStatusCodeValue()).isEqualTo(200);
    }
    @Test
    @Tag("invalid")
