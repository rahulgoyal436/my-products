    public void consecutiveDeleteRequestsForSameID() {
        // Arrange
        Long validID = 1L; 
        Product product = new Product();
        when(productRepository.findById(validID)).thenReturn(Optional.of(product)).thenReturn(Optional.empty());
        // Act
