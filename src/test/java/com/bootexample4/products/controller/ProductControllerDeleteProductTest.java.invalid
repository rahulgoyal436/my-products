    public void deleteProductWithEdgeCaseIDZero() {
        // Arrange
        Long edgeCaseID = 0L;
        when(productRepository.findById(edgeCaseID)).thenReturn(Optional.empty());
        // Act
        ResponseEntity<Object> response = productController.deleteProduct(edgeCaseID);
        // Assert
        verify(productRepository, never()).delete(any(Product.class));
        assertThat((int) response.getStatusCodeValue()).isEqualTo(404);
    }
