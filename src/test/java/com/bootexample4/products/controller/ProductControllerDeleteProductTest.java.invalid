    public void successfullyDeleteExistingProduct() {
        // Arrange
        Long existingProductId = Long.valueOf(1); // Modified to add proper type casting.
        Product mockProduct = new Product();
        mockProduct.setId(existingProductId);
        mockProduct.setName("Sample Product"); // Using proper defined attributes of the Product class.
        mockProduct.setDescription("Product Description");
        mockProduct.setPrice(99.99);
        
        when(productRepository.findById(existingProductId)).thenReturn(Optional.of(mockProduct));
        doNothing().when(productRepository).delete(mockProduct);
        // Act
