package com.bootexample4.products.controller;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.mockito.Mockito.*;
import static org.assertj.core.api.Assertions.*;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import java.util.List;
import java.util.Collections;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

class ProductControllerGetAllProductsTest {
    private ProductController productController;
    @Mock
    private ProductRepository productRepository;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        productController = new ProductController();
        productController.setProductRepository(productRepository); // Updated: Use setter to assign mock repository
    }
    @Test
    @Tag("valid")
    public void getAllProductsReturnsProductList() {
        Product product1 = new Product();
        product1.setId(1L);
        product1.setName("Product1");
        product1.setDescription("Description1");
        product1.setPrice(100.0);
        Product product2 = new Product();
        product2.setId(2L);
        product2.setName("Product2");
        product2.setDescription("Description2");
        product2.setPrice(200.0);
        List<Product> mockProducts = List.of(product1, product2);
        when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> result = productController.getAllProducts();
        assertThat(result).isNotNull();
        assertThat(result).hasSize(2);
        assertThat(result).containsExactlyInAnyOrderElementsOf(mockProducts);
        verify(productRepository, times(1)).findAll();
    }
    @Test
    @Tag("boundary")
    public void getAllProductsReturnsEmptyList() {
        when(productRepository.findAll()).thenReturn(Collections.emptyList());
        List<Product> result = productController.getAllProducts();
        assertThat((List<Product>) result).isNotNull(); // Ensure proper casting
        assertThat((List<Product>) result).isEmpty();
        verify(productRepository, times(1)).findAll();
    }
    @Test
    @Tag("boundary")
    public void getAllProductsReturnsSingleProductList() {
        Product product = new Product();
        product.setId(1L);
        product.setName("SingleProduct");
        product.setDescription("SingleDescription");
        product.setPrice(150.0);
        List<Product> mockProducts = List.of(product);
        when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> result = productController.getAllProducts();
        assertThat(result).isNotNull();
        assertThat(result).hasSize(1);
        assertThat(result.get(0)).isEqualTo(product);
        verify(productRepository, times(1)).findAll();
    }
    @Test
    @Tag("invalid")
    public void getAllProductsHandlesRepositoryErrors() {
        when(productRepository.findAll()).thenThrow(new RuntimeException("Repository Error"));
        assertThatThrownBy(() -> productController.getAllProducts())
                .isInstanceOf(RuntimeException.class)
                .hasMessage("Repository Error");
        verify(productRepository, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    public void getAllProductsReturnsNoDuplicateProducts() {
        Product product1 = new Product();
        product1.setId(1L);
        product1.setName("UniqueProduct1");
        product1.setDescription("Description1");
        product1.setPrice(100.0);
        Product product2 = new Product();
        product2.setId(2L);
        product2.setName("UniqueProduct2");
        product2.setDescription("Description2");
        product2.setPrice(200.0);
        List<Product> mockProducts = List.of(product1, product2);
        when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> result = productController.getAllProducts();
        assertThat(result).isNotNull();
        assertThat(result).hasSize(2);
        assertThat(result).containsOnly(product1, product2);
        verify(productRepository, times(1)).findAll();
    }
    @Test
    @Tag("invalid")
    public void getAllProductsHandlesNullRepository() {
        productController.setProductRepository(null); // Updated to use setter for null assignment
        assertThatThrownBy(() -> productController.getAllProducts())
                .isInstanceOf(NullPointerException.class);
    }
    @Test
    @Tag("integration")
    public void getAllProductsCallsRepositoryMethodOnce() {
        Product product1 = new Product();
        product1.setId(1L);
        product1.setName("Product1");
        product1.setDescription("Description1");
        product1.setPrice(120.0);
        List<Product> mockProducts = List.of(product1);
        when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> result = productController.getAllProducts();
        verify(productRepository, times(1)).findAll();
        assertThat(result).isNotNull();
        assertThat(result).hasSize(1);
    }
    @Test
    @Tag("boundary")
    public void getAllProductsIsThreadSafe() throws InterruptedException {
        Product product1 = new Product();
        product1.setId(1L);
        product1.setName("Product1");
        product1.setDescription("Description1");
        product1.setPrice(100.0);
        Product product2 = new Product();
        product2.setId(2L);
        product2.setName("Product2");
        product2.setDescription("Description2");
        product2.setPrice(200.0);
        List<Product> mockProducts = List.of(product1, product2);
        when(productRepository.findAll()).thenReturn(mockProducts);
        Runnable task = () -> {
            List<Product> result = productController.getAllProducts();
            assertThat(result).isNotNull();
            assertThat(result).containsExactlyInAnyOrderElementsOf(mockProducts);
        };
        Thread thread1 = new Thread(task);
        Thread thread2 = new Thread(task);
        thread1.start();
        thread2.start();
        thread1.join();
        thread2.join();
        verify(productRepository, atLeast(2)).findAll();
    }
}