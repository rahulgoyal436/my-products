package com.bootexample4.products.controller;import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import static org.junit.jupiter.api.Assertions.*;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

class ProductControllerGetAllProductsTest {
    private ProductController productController;
    @Autowired
    private ProductRepository productRepository;
    @BeforeEach
    void setUp() {
        productRepository = Mockito.mock(ProductRepository.class);
        productController = new ProductController(productRepository); // Modified constructor to accept productRepository
    }
    @Test
    @Tag("valid")
    public void getAllProductsReturnsValidList() {
        Product productA = new Product();
        productA.setId(1L);
        productA.setName("ProductA");
        productA.setDescription("DescriptionA");
        productA.setPrice(100.0);
        Product productB = new Product();
        productB.setId(2L);
        productB.setName("ProductB");
        productB.setDescription("DescriptionB");
        productB.setPrice(200.0);
        List<Product> mockProducts = new ArrayList<>();
        mockProducts.add(productA);
        mockProducts.add(productB);
        Mockito.when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> products = productController.getAllProducts();
        assertNotNull(products, "Product list should not be null");
        assertFalse(products.isEmpty(), "Product list should not be empty");
        assertEquals(mockProducts.size(), products.size(), "Product list size should match the mock size");
        assertEquals(mockProducts.get(0).getName(), products.get(0).getName(), "Product names should match");
    }
    @Test
    @Tag("boundary")
    public void getAllProductsReturnsEmptyList() {
        Mockito.when(productRepository.findAll()).thenReturn(new ArrayList<>());
        List<Product> products = productController.getAllProducts();
        assertNotNull(products, "Product list should not be null");
        assertTrue(products.isEmpty(), "Product list should be empty");
    }
    @Test
    @Tag("invalid")
    public void getAllProductsThrowsErrorIfRepositoryIsNull() {
        productController = new ProductController(null); // Pass null directly in constructor
        assertThrows(NullPointerException.class, () -> productController.getAllProducts(), "Expected NullPointerException when repository is null");
    }
    @Test
    @Tag("valid")
    public void getAllProductsPreservesRepositoryOrder() {
        Product productX = new Product();
        productX.setId(1L);
        productX.setName("ProductX");
        productX.setDescription("DescriptionX");
        productX.setPrice(300.0);
        Product productY = new Product();
        productY.setId(2L);
        productY.setName("ProductY");
        productY.setDescription("DescriptionY");
        productY.setPrice(400.0);
        List<Product> mockProducts = new ArrayList<>();
        mockProducts.add(productX);
        mockProducts.add(productY);
        Mockito.when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> products = productController.getAllProducts();
        assertEquals(mockProducts.get(0).getName(), products.get(0).getName(), "The first product's name should match");
        assertEquals(mockProducts.get(1).getName(), products.get(1).getName(), "The second product's name should match");
    }
    @Test
    @Tag("boundary")
    public void getAllProductsHandlesLargeLists() {
        List<Product> largeMockProducts = new ArrayList<>();
        for (long i = 0; i < 10_000; i++) {
            Product product = new Product();
            product.setId(i);
            product.setName("Product" + i);
            product.setDescription("Description" + i);
            product.setPrice(i * 10.0);
            largeMockProducts.add(product);
        }
        Mockito.when(productRepository.findAll()).thenReturn(largeMockProducts);
        List<Product> products = productController.getAllProducts();
        assertEquals(largeMockProducts.size(), products.size(), "Product list size should match the mock size");
    }
    @Test
    @Tag("boundary")
    public void getAllProductsIsReadOnly() {
        Product productA = new Product();
        productA.setId(1L);
        productA.setName("ProductA");
        productA.setDescription("DescriptionA");
        productA.setPrice(100.0);
        Product productB = new Product();
        productB.setId(2L);
        productB.setName("ProductB");
        productB.setDescription("DescriptionB");
        productB.setPrice(200.0);
        List<Product> mockProducts = new ArrayList<>();
        mockProducts.add(productA);
        mockProducts.add(productB);
        Mockito.when(productRepository.findAll()).thenReturn(mockProducts);
        productController.getAllProducts();
        Mockito.verify(productRepository, Mockito.times(1)).findAll();
        Mockito.verifyNoMoreInteractions(productRepository); // Ensure no write operations
    }
    @Test
    @Tag("valid")
    public void getAllProductsHandlesDuplicateEntries() {
        Product product = new Product();
        product.setId(1L);
        product.setName("ProductA");
        product.setDescription("Duplicate");
        product.setPrice(50.0);
        List<Product> mockProducts = List.of(product, product);
        Mockito.when(productRepository.findAll()).thenReturn(mockProducts);
        List<Product> products = productController.getAllProducts();
        assertEquals(mockProducts.size(), products.size(), "Product list size should match the duplicate mock size");
        assertEquals(mockProducts, products, "Duplicate entries should match the mock");
    }
    @Test
    @Tag("invalid")
    public void getAllProductsHandlesMalformedData() {
        Product malformedProduct = new Product();
        malformedProduct.setId(null);
        malformedProduct.setName(null);
        malformedProduct.setDescription(null);
        malformedProduct.setPrice(0);
        List<Product> malformedProducts = new ArrayList<>();
        malformedProducts.add(malformedProduct);
        Mockito.when(productRepository.findAll()).thenReturn(malformedProducts);
        List<Product> products = productController.getAllProducts();
        assertNotNull(products, "Product list should not be null");
        assertEquals(malformedProducts.size(), products.size(), "Returned list size should match the mock list size");
        assertNull(products.get(0).getName(), "Product name should be null for malformed data");
    }
}