    private ProductController productController;
    private ProductRepository productRepositoryMock;
    @BeforeEach
    public void setUp() {
        // Business logic function requires no-argument constructor usage for ProductController
        // Updating the test case setup to reflect this condition.
        productRepositoryMock = mock(ProductRepository.class);
        productController = new ProductController(); // Assuming ProductController has no-argument constructor
        productController.setProductRepository(productRepositoryMock); // Assume setter injection for productRepository
    }
    @Test
    @Tag("valid")
    public void getAllProductsShouldReturnListOfProducts() {
        // Arrange
